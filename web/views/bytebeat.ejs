<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Byteforge — Bytebeat</title>
<link rel="stylesheet" href="/static/css/base.css">
<link rel="stylesheet" href="/static/css/layout.css">
<link rel="stylesheet" href="/static/css/components.css">
</head>
<body>
<div id="app">
<aside class="sidebar" id="sidebar">
  <div class="logo"><a href="/">Byteforge</a></div>
  <nav>
    <a href="/">Dashboard</a>
    <a href="/converter">Converter</a>
    <a href="/editor">Code Editor</a>
    <a href="/svg">SVG Editor</a>
    <a href="/pdf">PDF Editor</a>
    <a href="/rss">RSS Reader</a>
    <a href="/bytebeat" class="active">Bytebeat</a>
    <a href="/settings">Settings</a>
  </nav>
</aside>
<main class="content">
  <header class="topbar">
    <button class="menu-toggle" id="menu-toggle" aria-label="Menu">☰</button>
    <h1>Bytebeat Composer</h1>
    <button class="cmd-btn" id="cmd-btn" title="Command palette (Ctrl+K)">⌘K</button>
  </header>
  <div class="page">
    <div class="card">
      <div class="form-group">
        <label for="bb-expr">Expression</label>
        <textarea id="bb-expr" rows="3" style="font-family:var(--font-mono);width:100%">(t*(t>>5|t>>8))>>(t>>16)</textarea>
      </div>
      <div class="btn-row">
        <button class="primary" id="bb-play">Play</button>
        <button id="bb-stop">Stop</button>
        <button id="bb-export">Export WAV</button>
        <button id="bb-save">Save</button>
        <button id="bb-load">Load</button>
      </div>
      <div class="btn-row" style="margin-top:0.75rem">
        <label>Preset <select id="bb-presets"></select></label>
        <label>Rate <select id="bb-rate">
          <option value="8000">8000</option>
          <option value="11025">11025</option>
          <option value="16000">16000</option>
          <option value="22050">22050</option>
          <option value="44100">44100</option>
          <option value="48000">48000</option>
        </select></label>
        <label>Duration <input type="number" id="bb-duration" value="5" min="0.5" max="30" step="0.5" style="width:4rem"></label>
        <label>Volume <input type="range" id="bb-volume" min="0" max="1" step="0.05" value="0.3"></label>
      </div>
      <canvas id="bb-canvas" style="width:100%;height:80px;margin-top:1rem;background:var(--surface-2);border-radius:var(--radius)"></canvas>
      <p class="status" id="bb-status"></p>
    </div>
  </div>
</main>
</div>
<div id="command-palette" class="cmd-palette hidden" role="dialog" aria-modal="true">
  <input type="search" id="cmd-input" placeholder="Type a command…" autocomplete="off">
  <ul id="cmd-list"></ul>
</div>
<script src="/static/js/app.js"></script>
<script src="/static/js/command-palette.js"></script>
<script src="/static/js/bytebeat.js"></script>
</body>
</html>
