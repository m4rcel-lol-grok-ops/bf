<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Byteforge — Code Editor</title>
<link rel="stylesheet" href="/static/css/base.css">
<link rel="stylesheet" href="/static/css/layout.css">
<link rel="stylesheet" href="/static/css/components.css">
<link rel="stylesheet" href="/static/css/editor.css">
</head>
<body>
<div id="app">
<aside class="sidebar" id="sidebar">
  <div class="logo">
    <a href="/">
      <span class="logo-mark">Bf</span>
      <span>Byteforge</span>
    </a>
  </div>
  <nav>
    <a href="/"><span class="nav-icon">⌂</span>Home</a>
    <a href="/converter"><span class="nav-icon">⇄</span>Convert</a>
    <a href="/editor" class="active"><span class="nav-icon">{ }</span>Code</a>
    <a href="/svg"><span class="nav-icon">◇</span>SVG</a>
    <a href="/pdf"><span class="nav-icon">▤</span>PDF</a>
    <a href="/rss"><span class="nav-icon">◉</span>RSS</a>
    <a href="/bytebeat"><span class="nav-icon">♪</span>Beat</a>
  </nav>
  <div class="sidebar-footer">
    <a href="/settings"><span class="nav-icon">⚙</span>Settings</a>
  </div>
</aside>
<main class="content">
  <div class="page">
    <div class="btn-row" style="margin-bottom:0.75rem">
      <select id="editor-lang">
        <option value="javascript">JavaScript</option>
        <option value="typescript">TypeScript</option>
        <option value="python">Python</option>
        <option value="go">Go</option>
        <option value="rust">Rust</option>
        <option value="html">HTML</option>
        <option value="css">CSS</option>
        <option value="json">JSON</option>
        <option value="yaml">YAML</option>
        <option value="markdown">Markdown</option>
        <option value="sql">SQL</option>
        <option value="bash">Bash</option>
        <option value="c">C</option>
        <option value="cpp">C++</option>
        <option value="java">Java</option>
        <option value="php">PHP</option>
        <option value="ruby">Ruby</option>
        <option value="lua">Lua</option>
      </select>
      <label>Font <input type="number" id="editor-fontsize" value="14" min="10" max="24" style="width:3.5rem"></label>
      <button id="editor-download">Download</button>
    </div>
    <textarea id="code-editor" spellcheck="false" style="width:100%;height:calc(100vh - 180px);font-family:var(--font-mono);font-size:14px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:1rem;resize:vertical;line-height:1.5">// Byteforge Code Editor
console.log("Hello from Byteforge");
</textarea>
  </div>
</main>
</div>
<div id="command-palette" class="cmd-palette hidden" role="dialog" aria-modal="true">
  <input type="search" id="cmd-input" placeholder="Type a command…" autocomplete="off">
  <ul id="cmd-list"></ul>
</div>
<script src="/static/js/app.js"></script>
<script src="/static/js/command-palette.js"></script>
<script src="/static/js/editor.js"></script>
</body>
</html>
