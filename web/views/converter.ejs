<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Byteforge — Converter</title>
<link rel="stylesheet" href="/static/css/base.css">
<link rel="stylesheet" href="/static/css/layout.css">
<link rel="stylesheet" href="/static/css/components.css">
</head>
<body>
<div id="app">
<aside class="sidebar" id="sidebar">
  <div class="logo">
    <a href="/">
      <span class="logo-mark">Bf</span>
      <span>Byteforge</span>
    </a>
  </div>
  <nav>
    <a href="/"><span class="nav-icon">⌂</span>Home</a>
    <a href="/converter" class="active"><span class="nav-icon">⇄</span>Convert</a>
    <a href="/editor"><span class="nav-icon">{ }</span>Code</a>
    <a href="/svg"><span class="nav-icon">◇</span>SVG</a>
    <a href="/pdf"><span class="nav-icon">▤</span>PDF</a>
    <a href="/rss"><span class="nav-icon">◉</span>RSS</a>
    <a href="/bytebeat"><span class="nav-icon">♪</span>Beat</a>
  </nav>
  <div class="sidebar-footer">
    <a href="/settings"><span class="nav-icon">⚙</span>Settings</a>
  </div>
</aside>
<main class="content">
  <div class="page">
    <div class="card">
      <div class="dropzone" id="dropzone">
        <p>Drop a file here or click to select</p>
        <input type="file" id="file-input">
      </div>
      <div class="form-group" style="margin-top:1rem">
        <label for="target-format">Target format</label>
        <select id="target-format"><option value="">Select file first</option></select>
      </div>
      <div class="progress hidden" id="progress"><div class="progress-bar" id="progress-bar"></div></div>
      <p class="status" id="status"></p>
    </div>
  </div>
</main>
</div>
<div id="command-palette" class="cmd-palette hidden" role="dialog" aria-modal="true">
  <input type="search" id="cmd-input" placeholder="Type a command…" autocomplete="off">
  <ul id="cmd-list"></ul>
</div>
<script src="/static/js/app.js"></script>
<script src="/static/js/command-palette.js"></script>
<script src="/static/js/converter.js"></script>
</body>
</html>
