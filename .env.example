# Byteforge configuration
APP_HOST=0.0.0.0
APP_PORT=18527

DATA_DIR=/data
TEMP_DIR=/tmp/byteforge

MAX_UPLOAD_SIZE=100MB
MAX_PDF_SIZE=100MB
MAX_IMAGE_SIZE=50MB
MAX_ARCHIVE_SIZE=100MB
MAX_PROCESSING_TIME=120
MAX_CONCURRENT_JOBS=2

TEMP_FILE_TTL=3600
CLEANUP_INTERVAL=300

RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=1m

LOG_LEVEL=info

READ_TIMEOUT=30s
READ_HEADER_TIMEOUT=10s
WRITE_TIMEOUT=120s
IDLE_TIMEOUT=120s
MAX_HEADER_BYTES=1048576
